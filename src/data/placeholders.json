  "skills": {
    "lastStand": {
      "name": "[LAST STAND]",
      "description": "Once per battle, below 30% HP: Defence +50%.",
      "hpBelow": 0.3,
      "defenceMultiplier": 1.5
    }
  },
  "mining": {
    "$comment": "Ore per run = min(cargo, miningYield per minute × run minutes).",
