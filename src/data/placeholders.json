{
  "$comment": "Every [PLACEHOLDER] value the human approved, in one place (GDD rule 0.2.5). Replace as decisions land. Times are in seconds.",
  "names": {
    "game": "[GAME TITLE]",
    "station": "[STATION NAME]",
    "ore1": "[ORE 1]",
    "ore2": "[ORE 2]",
    "material1": "[MATERIAL 1]",
    "material2": "[MATERIAL 2]",
    "component": "[COMPONENT]",
    "rareResource": "[RARE RESOURCE]",
    "pullCurrency": "[PULL CURRENCY]",
    "oreField1": "[ORE 1 FIELD]",
    "oreField2": "[ORE 2 FIELD]",
    "expedition": "[EXPEDITION NAME]",
    "enemyGroup": "[PIRATE GROUP]"
  },
  "crafting": {
    "$comment": "One crafting job runs at a time.",
    "maxConcurrentJobs": 1,
    "recipes": {
      "refineOre1": {
        "name": "Refine [ORE 1]",
        "inputs": { "ore1": 20 },
        "output": { "resource": "material1", "amount": 10 },
        "seconds": 30
      },
      "refineOre2": {
        "name": "Refine [ORE 2]",
        "inputs": { "ore2": 20 },
        "output": { "resource": "material2", "amount": 10 },
        "seconds": 30
      },
      "component": {
        "name": "Manufacture [COMPONENT]",
        "inputs": { "material1": 10, "material2": 10 },
        "output": { "resource": "component", "amount": 1 },
        "seconds": 45
      },
      "frigate": {
        "name": "Build Frigate",
        "inputs": { "component": 2 },
        "output": { "ship": "frigate" },
        "seconds": 60
      },
      "autocannon": {
        "name": "Craft [AUTOCANNON]",
        "inputs": { "material2": 10 },
        "output": { "gear": "autocannon" },
        "seconds": 30
      }
    }
  },
  "hulls": {
    "barge": {
      "name": "[MINING BARGE]",
      "class": "Industrial",
